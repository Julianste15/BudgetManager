<a:Creator>Duberney</a:Creator>
<a:ModificationDate>1732473492</a:ModificationDate>
<a:Modifier>Duberney</a:Modifier>
<a:Stereotype>Comparer</a:Stereotype>
<a:ReturnType>int</a:ReturnType>
<a:TemplateBody>{
  if (prmOther == null) return 1;
      int result = attOUID.CompareTo(prmOther.attOUID);
  if (result != 0) return result;
      result = attName.CompareTo(prmOther.attName);
  if (result != 0) return result;
      return attDescription.CompareTo(prmOther.attDescription);
}</a:TemplateBody>
<c:Parameters>
